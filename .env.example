# 실제 .env는 보존하세요. 새 테스트/개발 DB를 쓸 때만 본인 컴퓨터에서 설정합니다.
DATABASE_URL=postgresql+asyncpg://food_user:CHANGE_ME@127.0.0.1:5432/premium_food
JWT_SECRET_KEY=
SQL_ECHO=False
LOGGING_MODE=info

# New, disposable learning database only. create_all is not migration.
CREATE_TABLES=false
DEMO_SEED=false
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
